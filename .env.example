FLASK_APP=app_v4
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
# Docker: host port mapping for the web app (defaults to 5000)
WEB_PORT=5000

# In production set a strong key (32+ random bytes).
SECRET_KEY=your-secret-key

# Database (use DATABASE_URL or DB_* variables)
# If you use `docker compose` from this repo, Postgres is published on localhost:5433 by default.
DB_DIALECT=postgres        # postgres | sqlite
DATABASE_URL=postgresql://skilluser:skillpass@localhost:5433/skillswap
# DB_NAME=skillswap
# DB_USER=skilluser
# DB_PASSWORD=skillpass
# DB_HOST=localhost
# DB_PORT=5433
# SQLite (for quick local start without Postgres):
# DB_DIALECT=sqlite
# SQLITE_PATH=database.db

# Docker: host port mapping for Postgres (defaults to 5433)
DB_HOST_PORT=5433

# Uploads
UPLOAD_FOLDER=static/avatars

# SMTP (for password reset emails)
# For local development with Mailpit/Mailhog: SMTP_SERVER=localhost, SMTP_PORT=1025, SMTP_USE_TLS=0
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
